# Copy to .env and fill in when ready. Never commit the real .env.

# Optional: switches grading from the built-in heuristic grader to Claude automatically.
ANTHROPIC_API_KEY=

# Optional: shared-secret token required in the "token" form field on /api/grade.
# Set this before exposing the server via a public tunnel.
DEMO_TOKEN=

# tiny | base | small | medium (CPU speed vs accuracy tradeoff)
WHISPER_MODEL_SIZE=small
